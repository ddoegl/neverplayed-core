{
    "id": "org.neverplayed.realm.governance",
    "title": "Governance",
    "icon": "fas fa-users",
    "extends": ["org.neverplayed.realm.foundation"],
    "description": "Layer 4: Defines the governance structures and roles.",
    "privileges": {
        "realm-admins": ["daniel.doegl@doegl.info", "guest"]
    },
    "bundles": ["./bundles/org.neverplayed.person-registry/manifest.json"],
    "recognizedSurrogates": ["person"],
    "onAccessDenied": "Universe 'org.neverplayed.realm.governance' only recognizes Persons. Please materialize as a Person before entry.",
    "strategies": {
        "REALM_ACCESS:org.neverplayed.realm.governance": {
            "operator": "AND",
            "matchers": [
                { "type": "matchAttribute", "key": "surrogateId", "value": "person" }
            ]
        }
    },
    "domainObjects": []
}
