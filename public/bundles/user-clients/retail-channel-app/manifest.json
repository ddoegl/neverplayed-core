{
  "Bundle-SymbolicName": "retail-channel-app",
  "Bundle-Version": "1.0.0",
  "Bundle-Activator": "activator.js",
  "Configuration": {
    "flowType": "app-client",
    "channels": [
      "mobile-device",
      "web-browser"
    ],
    "client-config": {
      "title": "Retail App",
      "icon": "fas fa-university",
      "color": "orange-500",
      "security": {
        "requireAuth": true,
        "strategy": "sca",
        "provisioning": "license",
        "licenseChannel": "retail"
      },
      "navigation": {
        "defaultFlow": "user-home-retail",
        "defaultStep": "dashboard"
      }
    }
  }
}
