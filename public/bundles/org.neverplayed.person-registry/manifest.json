{
    "Bundle-SymbolicName": "org.neverplayed.person-registry",
    "Bundle-Name": "Person Registry",
    "Bundle-Description": "Governance flow for managing person identity records and user-ID mappings.",
    "Bundle-Version": "2.0.0",
    "Bundle-Activator": "activator.js",
    "Bundle-Assets": [
        "templates/dashboard.html",
        "templates/form.html",
        "data/persons.yaml"
    ],
    "Provide-Capability": "osgi.service; objectClass=\"org.neverplayed.PersonsService\", osgi.service; objectClass=\"org.neverplayed.infrastructure/persons/data\", osgi.service; objectClass=\"org.neverplayed.TransitionParticipant\", osgi.service; objectClass=\"org.neverplayed.flow.FlowService\", osgi.service; objectClass=\"org.neverplayed.plexus.KnowledgeProviderService\"",
    "Configuration": {
        "flowType": "system-flow",
        "channels": ["business-channel-web"],
        "sidebar": true,
        "icon": "fas fa-users",
        "required-permissions": ["person-admin"]
    }
}
