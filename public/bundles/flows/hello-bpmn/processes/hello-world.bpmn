<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://prototyper/hello-bpmn">

  <process id="hello-world" name="Hello World Process" isExecutable="true">

    <startEvent id="start" name="Start">
      <outgoing>flow-start-to-enter</outgoing>
    </startEvent>

    <userTask id="task-enter-name" name="Enter Your Name">
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="name" label="Your name" type="string" defaultValue=""/>
          <camunda:formField id="formal" label="Formal greeting?" type="boolean" defaultValue="false"/>
        </camunda:formData>
      </extensionElements>
      <incoming>flow-start-to-enter</incoming>
      <outgoing>flow-enter-to-build</outgoing>
    </userTask>

    <serviceTask id="task-build-greeting" name="Build Greeting" implementation="build-greeting">
      <incoming>flow-enter-to-build</incoming>
      <outgoing>flow-build-to-gateway</outgoing>
    </serviceTask>

    <exclusiveGateway id="gateway-formal" name="Formal?">
      <incoming>flow-build-to-gateway</incoming>
      <outgoing>flow-formal-yes</outgoing>
      <outgoing>flow-formal-no</outgoing>
    </exclusiveGateway>

    <serviceTask id="task-formal-greeting" name="Formal Greeting" implementation="formal-greeting">
      <incoming>flow-formal-yes</incoming>
      <outgoing>flow-formal-to-confirm</outgoing>
    </serviceTask>

    <serviceTask id="task-casual-greeting" name="Casual Greeting" implementation="casual-greeting">
      <incoming>flow-formal-no</incoming>
      <outgoing>flow-casual-to-confirm</outgoing>
    </serviceTask>

    <userTask id="task-confirm" name="Confirm &amp; Done">
      <incoming>flow-formal-to-confirm</incoming>
      <incoming>flow-casual-to-confirm</incoming>
      <outgoing>flow-confirm-to-end</outgoing>
    </userTask>

    <endEvent id="end" name="Done">
      <incoming>flow-confirm-to-end</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow-start-to-enter"   sourceRef="start"              targetRef="task-enter-name"/>
    <sequenceFlow id="flow-enter-to-build"   sourceRef="task-enter-name"    targetRef="task-build-greeting"/>
    <sequenceFlow id="flow-build-to-gateway" sourceRef="task-build-greeting" targetRef="gateway-formal"/>
    <sequenceFlow id="flow-formal-yes"       sourceRef="gateway-formal"     targetRef="task-formal-greeting"  name="Yes">
      <conditionExpression xsi:type="tFormalExpression">${formal === 'true' || formal === true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-formal-no"        sourceRef="gateway-formal"     targetRef="task-casual-greeting"  name="No"/>
    <sequenceFlow id="flow-formal-to-confirm" sourceRef="task-formal-greeting" targetRef="task-confirm"/>
    <sequenceFlow id="flow-casual-to-confirm" sourceRef="task-casual-greeting" targetRef="task-confirm"/>
    <sequenceFlow id="flow-confirm-to-end"   sourceRef="task-confirm"       targetRef="end"/>
  </process>

  <!-- Diagram Interchange (layout for viewer) -->
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="hello-world">

      <bpmndi:BPMNShape id="shape-start" bpmnElement="start">
        <dc:Bounds x="160" y="220" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="155" y="263" width="46" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-enter-name" bpmnElement="task-enter-name">
        <dc:Bounds x="240" y="198" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-build-greeting" bpmnElement="task-build-greeting">
        <dc:Bounds x="410" y="198" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-gateway-formal" bpmnElement="gateway-formal" isMarkerVisible="true">
        <dc:Bounds x="585" y="213" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="578" y="270" width="64" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-formal-greeting" bpmnElement="task-formal-greeting">
        <dc:Bounds x="690" y="120" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-casual-greeting" bpmnElement="task-casual-greeting">
        <dc:Bounds x="690" y="300" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-confirm" bpmnElement="task-confirm">
        <dc:Bounds x="870" y="198" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape-end" bpmnElement="end">
        <dc:Bounds x="1050" y="220" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1046" y="263" width="44" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="edge-start-enter"       bpmnElement="flow-start-to-enter">
        <di:waypoint x="196" y="238"/><di:waypoint x="240" y="238"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-enter-build"        bpmnElement="flow-enter-to-build">
        <di:waypoint x="360" y="238"/><di:waypoint x="410" y="238"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-build-gateway"      bpmnElement="flow-build-to-gateway">
        <di:waypoint x="530" y="238"/><di:waypoint x="585" y="238"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-formal-yes"         bpmnElement="flow-formal-yes">
        <di:waypoint x="610" y="213"/><di:waypoint x="610" y="160"/><di:waypoint x="690" y="160"/>
        <bpmndi:BPMNLabel><dc:Bounds x="622" y="183" width="21" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-formal-no"          bpmnElement="flow-formal-no">
        <di:waypoint x="610" y="263"/><di:waypoint x="610" y="340"/><di:waypoint x="690" y="340"/>
        <bpmndi:BPMNLabel><dc:Bounds x="622" y="298" width="15" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-formal-confirm"     bpmnElement="flow-formal-to-confirm">
        <di:waypoint x="810" y="160"/><di:waypoint x="930" y="160"/><di:waypoint x="930" y="198"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-casual-confirm"     bpmnElement="flow-casual-to-confirm">
        <di:waypoint x="810" y="340"/><di:waypoint x="930" y="340"/><di:waypoint x="930" y="278"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge-confirm-end"        bpmnElement="flow-confirm-to-end">
        <di:waypoint x="990" y="238"/><di:waypoint x="1050" y="238"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
