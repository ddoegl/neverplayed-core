{
  "Bundle-SymbolicName": "org.neverplayed.event-monitor",
  "Bundle-Version": "1.0.0",
  "Bundle-Name": "Event Monitor",
  "Bundle-Description": "Real-time observer for OSGi EventAdmin and platform signaling.",
  "Bundle-Activator": "activator.js",
  "Provide-Capability": "osgi.service; objectClass=\"@pandino/event-admin/EventHandler\", osgi.service; objectClass=\"org.neverplayed.flow.FlowService\"",
  "Configuration": {
    "flowType": "system-flow",
    "channels": [
      "real-life",
      "business-channel-web"
    ],
    "level": "INFO",
    "topics": [
      "backoffice/invitations/*",
      "backoffice/cases/*",
      "org/neverplayed/config/*",
      "neverplayed/realm/*"
    ],
    "sidebar": true
  }
}
