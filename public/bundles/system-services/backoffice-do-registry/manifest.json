{
    "Bundle-SymbolicName": "backoffice-do-registry",
    "Bundle-Version": "1.0.0",
    "Bundle-Activator": "./activator.js",
    "Require-Capability": [
        "pandino.util.yaml;version=\"1.0.0\"",
        "osgi.service; filter=\"(objectClass=pandino.persistence.manager)\""
    ],
    "Provide-Capability": [
        "osgi.service; objectClass=\"backoffice.domain.object.registry\""
    ],
    "Configuration": {
        "flowType": "backoffice-flow",
        "channels": [
            "backoffice-web"
        ]
    }
}
