{
  "Bundle-ManifestVersion": "1",
  "Bundle-SymbolicName": "backoffice.campaigns",
  "Bundle-Name": "Backoffice Campaigns Extension",
  "Bundle-Description": "Management for Campaigns and Strategies",
  "Bundle-Version": "1.0.0",
  "Bundle-Activator": "./activator.js",
  "Require-Capability": [
    "pandino.util.yaml;version=\"1.0.0\"",
    "backoffice.shell;version=\"1.0.0\"",
    "osgi.service; filter:=\"(objectClass=backoffice.data.tenants)\"",
    "osgi.service; filter:=\"(objectClass=backoffice.capabilities.data)\"",
    "backoffice.business.functions;version=\"1.0.0\""
  ],
  "Configuration": {
    "flowType": "backoffice-flow",
    "channels": [
      "backoffice-web"
    ]
  }
}
