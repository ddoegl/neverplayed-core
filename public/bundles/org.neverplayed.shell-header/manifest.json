{
    "Bundle-SymbolicName": "org.neverplayed.shell-header",
    "Bundle-Version": "1.0.0",
    "Bundle-Name": "Shell Header UI",
    "Bundle-Description": "Top navigation and session management bar (Reactive OSGi).",
    "Bundle-Activator": "activator.js",
    "Provide-Capability": "osgi.service; objectClass=\"@pandino/event-admin/EventHandler\"",
    "Import-Service": [
        "@pandino/event-admin/EventAdmin",
        "org.neverplayed.realm.RealmManager"
    ],
    "Configuration": {
        "channels": [
            "business-channel-web"
        ],
        "mountPoint": "#shell-header"
    }
}
