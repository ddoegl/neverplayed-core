{
    "Bundle-SymbolicName": "org.neverplayed.stratum-core",
    "Bundle-Version": "1.0.0",
    "Bundle-Name": "Stratum Core",
    "Bundle-Description": "Aggregates multi-facet state (Tenant, Identity, Realm, Tier) into a unified Stratum context (Layer 1).",
    "Bundle-Activator": "activator.js",
    "Provide-Capability": "osgi.service; objectClass=\"org.neverplayed.stratum.StratumService\"",
    "Configuration": {
        "log-level": "INFO"
    },
    "Patterns": {
        "SDN-0165": "Sovereign Identity Scoping",
        "ADR-0165": "Hierarchical Context Sharding"
    }
}
