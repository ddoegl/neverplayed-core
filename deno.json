{
  "tasks": {
    "start": "deno run -A ./serve.ts",
    "start-exp": "deno run -A ./serve-experiments.ts",
    "lint": "deno lint public/bundles/",
    "check-types": "deno check public/shared-types.js",
    "audit": "deno run -A scripts/audit-identifiers.ts",
    "verify": "deno task lint && deno task check-types && deno task audit",
    "kill-deno": "lsof -ti:8008 | xargs kill -9",
    "kill-deno-exp": "lsof -ti:8009 | xargs kill -9",
    "headless": "deno run -A --location http://localhost --import-map scripts/import-map.json scripts/headless-boot.ts",
    "headless-fs": "deno run -A --location http://localhost --import-map scripts/import-map.json scripts/headless-boot-fs.ts",
    "terminal": "deno run -A --location http://localhost --import-map scripts/import-map.json scripts/headless-terminal.ts",
    "terminal-web": "deno run -A --location http://localhost --import-map scripts/import-map.json scripts/headless-terminal.ts --url http://localhost:8008/",
    "test": "deno run -A tests/run-all.ts",
    "test:shunting": "deno test -A tests/persistence-shunting.test.ts",
    "test:shunting-universal": "deno run -A tests/test-universal-shunting.ts",
    "test:lean-activator": "deno run -A tests/test-lean-activator.ts",
    "test:auth": "deno run -A tests/test-firebase-auth.ts",
    "test:mcp": "deno run -A tests/test-mcp-client.ts",
    "test:security": "deno run -A tests/verify-security.ts",
    "test:persistence-matrix": "PERSISTENCE_MODE=local deno test -A tests/persistence-matrix.test.ts",
    "lint:arch:core": "deno run -A scripts/lint-arch.ts --layer core",
    "lint:arch:foundation": "deno run -A scripts/lint-arch.ts --layer foundation",
    "lint:arch:domain": "deno run -A scripts/lint-arch.ts --layer domain",
    "mcp": "deno run -A --location http://localhost --import-map scripts/import-map.json scripts/mcp-server.ts"
  },
  "lint": {
    "files": {
      "include": ["public/bundles/"],
      "exclude": ["public/bundles/system-services/backoffice-licenses/lib/"]
    }
  },
  "imports": {
    "shared-types": "./public/shared-types.js",
    "core-types": "./public/core-types.js",
    "osgi-base": "./public/osgi-base.js",
    "alpine-base": "./public/alpine-base.js",
    "alpinejs": "https://esm.sh/alpinejs@3.13.5",
    "@neverplayed/shared-ui/": "./public/bundles/org.neverplayed.shared-ui/",
    "@neverplayed/selection-service/": "./public/bundles/org.neverplayed.selection-service/",
    "@neverplayed/do-registry/": "./public/bundles/org.neverplayed.do-registry/",
    "@neverplayed/realm.real-life/": "./public/bundles/org.neverplayed.realm.real-life/",
    "@neverplayed/visual-editor/": "./public/bundles/org.neverplayed.visual-editor/",
    "@neverplayed/showcase/": "./public/bundles/org.neverplayed.showcase/",
    "@neverplayed/config-admin/": "./public/bundles/org.neverplayed.config-admin/",
    "@neverplayed/event-monitor/": "./public/bundles/org.neverplayed.event-monitor/",
    "@pandino/pandino": "https://esm.sh/@pandino/pandino@0.8.33",
    "@pandino/pandino/": "https://esm.sh/@pandino/pandino@0.8.33/",
    "@pandino/pandino-api": "https://esm.sh/@pandino/pandino-api@0.8.33",
    "@pandino/pandino-api/": "https://esm.sh/@pandino/pandino-api@0.8.33/",
    "@pandino/persistence-manager-api": "https://esm.sh/@pandino/persistence-manager-api@0.8.33",
    "@pandino/persistence-manager-api/": "https://esm.sh/@pandino/persistence-manager-api@0.8.33/",
    "@pandino/persistence-manager-localstorage": "https://esm.sh/@pandino/persistence-manager-localstorage@0.8.33",
    "@pandino/persistence-manager-localstorage/": "https://esm.sh/@pandino/persistence-manager-localstorage@0.8.33/",
    "@pandino/event-api": "https://esm.sh/@pandino/event-api@0.8.33",
    "@pandino/event-api/": "https://esm.sh/@pandino/event-api@0.8.33/",
    "@pandino/log-api": "https://esm.sh/@pandino/log-api@0.8.33",
    "@pandino/log-api/": "https://esm.sh/@pandino/log-api@0.8.33/"
  }
}
